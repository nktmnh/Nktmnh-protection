<Application x:Class="NktmnhProtection.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark"
                                             PrimaryColor="DeepPurple"
                                             SecondaryColor="Cyan" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <ResourceDictionary Source="Localization/Strings.en.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Custom palette -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0D0D12" />
            <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#16161F" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1E1E2A" />
            <SolidColorBrush x:Key="AccentGlowBrush" Color="#7C4DFF" />
            <SolidColorBrush x:Key="DropZoneBorderBrush" Color="#3D3D55" />
            <SolidColorBrush x:Key="DropZoneHoverBrush" Color="#7C4DFF" />
            <SolidColorBrush x:Key="LogBackgroundBrush" Color="#0A0A0F" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
